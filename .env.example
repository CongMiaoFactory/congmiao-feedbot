# 必填
TELEGRAM_BOT_TOKEN=

# Telegram：默认 Polling；填写完整公网 HTTPS 地址后切换 Webhook
# WEBHOOK_URL=https://bot.example.com/webhook
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
# 自建 telegram-bot-api 时填写服务根地址，例如 http://telegram-bot-api:8081
# TELEGRAM_API_URL=
LOCAL_MODE=false

DATABASE_URL=sqlite://data/feedbot.db?mode=rwc
# 启动 compose redis profile 后可填 redis://redis:6379
# REDIS_URL=

FXTWITTER_API_BASE=https://api.fxtwitter.com
PIXIV_WEB_API_BASE=https://www.pixiv.net
NETEASE_API_BASE=http://127.0.0.1:3000
# YOUTUBE_API_KEY=
# YOUTUBE_COOKIES_FILE=/app/secrets/youtube-cookies.txt
# PIXIV_REFRESH_TOKEN=
# 可选初始值；推荐在 Bot 私聊使用 /login netease 扫码更新
# NETEASE_COOKIE=
# BILIBILI_COOKIE=SESSDATA=...; bili_jct=...; buvid3=...
# 管理员 Telegram 数字 ID，/login 只允许该用户在私聊使用
# ADMIN_USER_ID=123456789
# BILIBILI_PASSPORT_BASE=https://passport.bilibili.com
# BILIBILI_API_BASE=https://api.bilibili.com
# BILIBILI_LIVE_API_BASE=https://api.live.bilibili.com
# BILIBILI_WWW_BASE=https://www.bilibili.com

FFMPEG_PATH=ffmpeg
YT_DLP_PATH=yt-dlp
TEMP_DIR=tmp
UPLOAD_WORKERS=4
MAX_QUEUE_SIZE=200
# 0 表示关闭用户限流
REQUEST_LIMIT_COUNT=0
REQUEST_LIMIT_TTL=86400
RUST_LOG=congmiao_feedbot=info
